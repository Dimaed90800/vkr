{
  "openapi": "3.0.3",
  "info": {
    "title": "Demo Target API",
    "version": "0.1.0"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8001"
    }
  ],
  "paths": {
    "/identity/api/v2/vehicle/{vehicle_id}/location": {
      "get": {
        "summary": "Get vehicle location",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "vehicle_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "mode",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["secure", "vulnerable"]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Vehicle location"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
