{
  "name": "Batch Experiments With Reports",
  "nodes": [
    {
      "parameters": {},
      "id": "manualTrigger",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        260,
        300
      ]
    },
    {
      "parameters": {
        "keepOnlySet": true,
        "values": {
          "string": [
            {
              "name": "target_name",
              "value": "crapi"
            },
            {
              "name": "target_url",
              "value": "http://host.docker.internal:8888"
            },
            {
              "name": "profile",
              "value": "mixed"
            }
          ],
          "number": [
            {
              "name": "max_rounds",
              "value": 15
            }
          ]
        },
        "options": {}
      },
      "id": "setBatchConfig",
      "name": "Set Batch Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        500,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8000/experiments/run-batch-with-reports",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"target_name\": $json.target_name,\n  \"target_url\": $json.target_url,\n  \"profile\": $json.profile,\n  \"max_rounds\": $json.max_rounds,\n  \"judge_modes\": [\"rule_based\", \"dify\", \"unified\"]\n}",
        "options": {
          "timeout": 600000
        }
      },
      "id": "runBatchWithReports",
      "name": "Run Batch With Reports",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        780,
        300
      ]
    },
    {
      "parameters": {
        "keepOnlySet": true,
        "values": {
          "string": [
            {
              "name": "target_name",
              "value": "={{ $json.batch.target_name }}"
            },
            {
              "name": "target_url",
              "value": "={{ $json.batch.target_url }}"
            },
            {
              "name": "profile",
              "value": "={{ $json.batch.profile }}"
            },
            {
              "name": "judge_modes",
              "value": "={{ ($json.batch.judge_modes || []).join(', ') }}"
            },
            {
              "name": "session_report_paths",
              "value": "={{ ($json.session_reports || []).map(report => `${report.judge_mode}: ${report.saved_report_path}`).join('\\n') }}"
            },
            {
              "name": "report_previews",
              "value": "={{ ($json.session_reports || []).map(report => `## ${report.judge_mode} / session ${report.session_id}\\n${report.report_preview || ''}`).join('\\n\\n') }}"
            }
          ],
          "number": [
            {
              "name": "runs_total",
              "value": "={{ $json.batch.runs_total }}"
            }
          ]
        },
        "options": {}
      },
      "id": "BuildSummary",
      "name": "Build Summary",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1060,
        300
      ]
    }
  ],
  "connections": {
    "Manual Trigger": {
      "main": [
        [
          {
            "node": "Set Batch Config",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Set Batch Config": {
      "main": [
        [
          {
            "node": "Run Batch With Reports",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run Batch With Reports": {
      "main": [
        [
          {
            "node": "Build Summary",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
  "active": false,
  "settings": {},
  "versionId": "1",
  "meta": {
    "templateCredsSetupCompleted": true
  },
  "id": "batch-experiments-with-reports",
  "tags": []
}
