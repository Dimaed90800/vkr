{
  "name": "Batch Job Runner (Polling)",
  "nodes": [
    {
      "parameters": {},
      "id": "manualTrigger",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        260,
        300
      ]
    },
    {
      "parameters": {
        "keepOnlySet": true,
        "values": {
          "string": [
            {
              "name": "target_name",
              "value": "crapi"
            },
            {
              "name": "target_url",
              "value": "http://host.docker.internal:8888"
            },
            {
              "name": "profile",
              "value": "mixed"
            }
          ],
          "number": [
            {
              "name": "max_rounds",
              "value": 15
            }
          ]
        },
        "options": {}
      },
      "id": "setBatchConfig",
      "name": "Set Batch Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        500,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8000/automation/run-batch-job",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"target_name\": $json.target_name,\n  \"target_url\": $json.target_url,\n  \"profile\": $json.profile,\n  \"max_rounds\": $json.max_rounds,\n  \"judge_modes\": [\"rule_based\", \"dify\", \"unified\"]\n}",
        "options": {
          "timeout": 600000
        }
      },
      "id": "startBatchJob",
      "name": "Start Batch Job",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        780,
        300
      ]
    },
    {
      "parameters": {
        "amount": 10,
        "unit": "seconds"
      },
      "id": "waitForJob",
      "name": "Wait For Job",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        1040,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ 'http://host.docker.internal:8000/automation/jobs/' + $json.job_id }}",
        "options": {
          "timeout": 600000
        }
      },
      "id": "getJobStatus",
      "name": "Get Job Status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1300,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.status }}",
              "operation": "equal",
              "value2": "finished"
            }
          ]
        }
      },
      "id": "ifFinished",
      "name": "If Finished",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1560,
        300
      ]
    },
    {
      "parameters": {
        "keepOnlySet": true,
        "values": {
          "string": [
            {
              "name": "job_id",
              "value": "={{ $json.job_id }}"
            },
            {
              "name": "status",
              "value": "={{ $json.status }}"
            },
            {
              "name": "target_name",
              "value": "={{ $json.result.batch.target_name }}"
            },
            {
              "name": "profile",
              "value": "={{ $json.result.batch.profile }}"
            },
            {
              "name": "artifact_dir",
              "value": "={{ $json.artifact_dir }}"
            },
            {
              "name": "summary_markdown",
              "value": "={{ $json.result.artifact_paths.summary_markdown }}"
            },
            {
              "name": "report_paths",
              "value": "={{ JSON.stringify($json.result.session_reports, null, 2) }}"
            },
            {
              "name": "job_summary",
              "value": "={{ 'Job ' + $json.job_id + ' finished. Reports saved in ' + $json.artifact_dir }}"
            }
          ],
          "number": [
            {
              "name": "runs_total",
              "value": "={{ $json.result.batch.runs_total }}"
            }
          ]
        },
        "options": {}
      },
      "id": "buildJobSummary",
      "name": "Build Job Summary",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1820,
        220
      ]
    }
  ],
  "connections": {
    "Manual Trigger": {
      "main": [
        [
          {
            "node": "Set Batch Config",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Set Batch Config": {
      "main": [
        [
          {
            "node": "Start Batch Job",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Start Batch Job": {
      "main": [
        [
          {
            "node": "Wait For Job",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Wait For Job": {
      "main": [
        [
          {
            "node": "Get Job Status",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Job Status": {
      "main": [
        [
          {
            "node": "If Finished",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "If Finished": {
      "main": [
        [
          {
            "node": "Build Job Summary",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Wait For Job",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
  "active": false,
  "settings": {},
  "versionId": "1",
  "meta": {
    "templateCredsSetupCompleted": true
  },
  "id": "batch-job-runner-polling",
  "tags": []
}
