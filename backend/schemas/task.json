{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vkr.local/schemas/task.json",
  "title": "AgenticTask",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "class",
    "subtype",
    "endpoint",
    "method",
    "params",
    "auth_context",
    "hypothesis",
    "priority",
    "retry_count",
    "rework_hint",
    "status",
    "allowed_tools"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "class": {
      "type": "string",
      "enum": ["authorization", "injection", "business_logic"]
    },
    "subtype": {
      "type": "string",
      "minLength": 1
    },
    "endpoint": {
      "type": "string",
      "minLength": 1
    },
    "method": {
      "type": "string",
      "enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS"]
    },
    "params": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "path_params": {
          "type": "array",
          "items": { "type": "string" }
        },
        "query_params": {
          "type": "array",
          "items": { "type": "string" }
        },
        "body_fields": {
          "type": "array",
          "items": { "type": "string" }
        },
        "object_id_candidates": {
          "type": "array",
          "items": {
            "type": ["string", "number"]
          }
        }
      }
    },
    "auth_context": {
      "type": "object",
      "additionalProperties": true,
      "required": ["owner_role", "other_role"],
      "properties": {
        "owner_role": {
          "type": ["string", "null"]
        },
        "other_role": {
          "type": ["string", "null"]
        },
        "token_strategy": {
          "type": ["string", "null"]
        }
      }
    },
    "hypothesis": {
      "type": "string",
      "minLength": 1
    },
    "priority": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "retry_count": {
      "type": "integer",
      "minimum": 0
    },
    "rework_hint": {
      "type": ["string", "null"]
    },
    "status": {
      "type": "string",
      "enum": ["pending", "in_progress", "confirmed", "rejected", "rework"]
    },
    "allowed_tools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
