{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vkr.local/schemas/verdict.json",
  "title": "JudgeVerdict",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "verdict",
    "confidence",
    "reason",
    "rework_hint",
    "severity",
    "finding_candidate"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "verdict": {
      "type": "string",
      "enum": ["confirmed", "rejected", "rework"]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "rework_hint": {
      "type": ["string", "null"]
    },
    "severity": {
      "type": "string",
      "enum": ["low", "medium", "high", "critical"]
    },
    "finding_candidate": {
      "type": ["object", "null"],
      "additionalProperties": true,
      "properties": {
        "title": { "type": "string" },
        "vuln_type": { "type": "string" },
        "endpoint": { "type": "string" },
        "method": { "type": "string" },
        "evidence_summary": { "type": "string" },
        "reproduction_steps": {
          "type": "array",
          "items": { "type": "string" }
        },
        "remediation": { "type": "string" }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "verdict": { "const": "rework" }
        }
      },
      "then": {
        "properties": {
          "rework_hint": { "type": "string", "minLength": 1 },
          "finding_candidate": { "type": "null" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verdict": { "const": "confirmed" }
        }
      },
      "then": {
        "properties": {
          "finding_candidate": { "type": "object" }
        }
      }
    }
  ]
}
